{
  "name": "xianxia-simulator",
  "version": "1.0.0",
  "description": "一款修仙题材的网页游戏模拟器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.game.xianxia",
    "productName": "修仙模拟器",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "favicon.ico"
    },
    "files": [
      "*.html",
      "*.js",
      "css/**/*",
      "js/**/*",
      "docs/**/*"
    ],
    "asar": true
  }
}
